{
  "name": "magatama-gmk00001",
  "main": "src/app.cljc",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": ["nodejs_compat", "nodejs_als"],
  "assets": {
    "directory": "./svelte/build",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "APP_ACTOR_HANDLE": "gameka",
    "APP_CAPABILITIES": "[\"edge-assets\",\"bpmn-dispatch\"]",
    "APP_DESCRIPTION": "Edge facade + internal /_d1 endpoint for Gameka, a UI-less gameSpec backend generation actor (invoked pod-to-pod by lg-shinshi). Produced ai.gftd.gameka.gameSpec records persist to Cloudflare D1 (ai-gftd-gameka).",
    "APP_DISPLAY_NAME": "Gameka",
    "APP_FRAMEWORK": "ts-native",
    "APP_NANOID": "gmk00001",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "appview"
  },
  // database_id: fill after `wrangler d1 create ai-gftd-gameka`.
  "d1_databases": [
    { "binding": "GAMEKA_DB", "database_name": "ai-gftd-gameka", "database_id": "89d460d8-0d98-41e4-a22a-7bbd38141fe6" }
  ],
  "secrets_store_secrets": [
    { "binding": "DISPATCHER_INTERNAL_SECRET", "store_id": "1824561668fe47cc9127d493961885af", "secret_name": "dispatcher_internal_secret" }
  ],
  "routes": [
    { "pattern": "gmk00001.gftd.ai/*", "zone_name": "gftd.ai" },
    { "pattern": "gameka.gftd.ai/*", "zone_name": "gftd.ai" }
  ]
}
